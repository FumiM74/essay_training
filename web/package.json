{
	"name": "web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.19.0",
	"engines": {
		"node": ">=24.19.0 <25",
		"pnpm": "11.19.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"curriculum:build": "node scripts/convert-curriculum.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"verify": "pnpm curriculum:build && pnpm check && pnpm test && pnpm build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"supabase": "supabase --workdir ..",
		"db:status": "supabase --workdir .. migration list",
		"db:push:dry": "supabase --workdir .. db push --dry-run",
		"db:test:rls": "supabase --workdir .. db query --linked --file supabase/tests/learner_data_rls.sql",
		"db:security": "supabase --workdir .. db advisors --linked --type security"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"exceljs": "^4.4.0",
		"jszip": "^3.10.1",
		"supabase": "2.115.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@supabase/supabase-js": "^2.112.3"
	}
}
